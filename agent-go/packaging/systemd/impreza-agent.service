[Unit]
Description=Impreza Platform Agent
Documentation=https://docs.imprezahost.com/agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/impreza-agent run
Restart=on-failure
RestartSec=5s

# The agent needs to talk to the local Docker socket (later phases) and
# to manage systemd-level units. Running as root keeps the MVP simple.
# A later phase will introduce a least-privilege model with capability
# bounding once the executor surface stabilizes.
User=root
Group=root

# Standard hardening compatible with our future Docker/Caddy needs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/etc/impreza-agent /var/lib/impreza-agent /var/log/impreza-agent

# Cap the file handle count generously — long-poll keeps one connection
# per agent open, but log streaming + container exec can briefly spike.
LimitNOFILE=65536

# JSON logs flow straight to the journal; structured fields are
# indexed and queryable via `journalctl -u impreza-agent --output=json`.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
